FROM node:22-alpine as dependencies
WORKDIR /mpyapp
COPY package*.json ./
RUN npm ci

FROM node:22-alpine as build
WORKDIR /myapp
COPY --from=dependencies /myapp/node_modules ./node_modules
COPY . .
RUN npm run build

From node:22-alpine as prod
WORKDIR /myappp
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /myapp/dist ./dist
EXPOSE 3000
USER node
CMD ["node","dist/server.js"]
