-- Display all heroes
SELECT * FROM tfi_heroes;

-- Display heroes in descending order of remuneration
SELECT
    hero_name,
    remuneration_crores
FROM tfi_heroes
ORDER BY remuneration_crores DESC;

-- Find heroes earning more than ₹50 crore
SELECT
    hero_name,
    remuneration_crores
FROM tfi_heroes
WHERE remuneration_crores > 50;

-- Find the highest-paid hero
SELECT
    hero_name,
    remuneration_crores
FROM tfi_heroes
ORDER BY remuneration_crores DESC
LIMIT 1;

-- Calculate the average remuneration
SELECT
    ROUND(AVG(remuneration_crores), 2) AS average_remuneration_crores
FROM tfi_heroes;

-- Count the number of heroes
SELECT COUNT(*) AS total_heroes
FROM tfi_heroes;
