-- tfi_heroes.sql
-- Sample database of TFI (Telugu Film Industry) heroes
-- Remuneration figures are approximate/sample values in INR crores.

CREATE DATABASE IF NOT EXISTS tfi_database;

USE tfi_database;

DROP TABLE IF EXISTS tfi_heroes;

CREATE TABLE tfi_heroes (
    hero_id INT PRIMARY KEY AUTO_INCREMENT,
    hero_name VARCHAR(100) NOT NULL,
    remuneration_crores DECIMAL(10,2),
    debut_year INT,
    popular_movie VARCHAR(150)
);

